{
  "manifest_version": 3,
  "name": "Readability Lab",
  "short_name": "Readability Lab",
  "version": "0.1.0",
  "description": "Adjust how web articles read — size, line length, spacing, font, colors — and inspect the result. Local only.",
  "permissions": ["storage", "activeTab", "scripting"],
  "optional_host_permissions": ["http://*/*", "https://*/*"],
  "action": { "default_popup": "popup.html", "default_title": "Readability Lab", "default_icon": { "16": "icons/icon-16.png", "32": "icons/icon-32.png" } },
  "icons": { "16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png" },
  "options_ui": { "page": "options.html", "open_in_tab": true },
  "commands": {
    "toggle-styles": { "suggested_key": { "default": "Alt+Shift+R" }, "description": "Turn reading settings on or off for this page" },
    "toggle-reader": { "suggested_key": { "default": "Alt+Shift+V" }, "description": "Open or close the reader view" },
    "compare": { "suggested_key": { "default": "Alt+Shift+C" }, "description": "Switch between original and adjusted page" }
  },
  "content_security_policy": { "extension_pages": "script-src 'self'; object-src 'none'; connect-src 'none'" }
}
