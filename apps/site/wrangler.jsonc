// Cloudflare Workers static assets: serves the site at https://camasuvi.net/readability/.
// `pnpm -C apps/site build` writes dist-deploy/readability/ so asset paths match the route.
// Headers, including the CSP, come from dist/_headers.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "readability-lab-site",
  "compatibility_date": "2026-11-13",
  "assets": { "directory": "./dist-deploy" },
  "routes": [{ "pattern": "camasuvi.net/readability*", "zone_name": "camasuvi.net" }],
  "workers_dev": false,
  "preview_urls": false
}
