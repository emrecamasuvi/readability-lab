{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/EvidenceRegistry",
  "$defs": {
    "EvidenceRegistry": {
      "type": "object",
      "properties": {
        "$schema": {
          "type": "string"
        },
        "registryVersion": {
          "type": "string"
        },
        "checkedOn": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "synthesis": {
          "type": "object",
          "properties": {
            "title": {
              "type": "string"
            },
            "note": {
              "type": "string"
            }
          },
          "required": [
            "title",
            "note"
          ]
        },
        "sources": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Source"
          }
        },
        "claims": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Claim"
          }
        },
        "gaps": {
          "default": [],
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "description": {
                "type": "string"
              },
              "affects": {
                "default": [],
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            },
            "required": [
              "id",
              "description"
            ]
          }
        }
      },
      "required": [
        "registryVersion",
        "checkedOn",
        "synthesis",
        "sources",
        "claims"
      ],
      "title": "Readability Lab evidence registry"
    },
    "Source": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^S-[a-z0-9-]+$"
        },
        "type": {
          "type": "string",
          "enum": [
            "standard",
            "standard-guidance",
            "journal-article",
            "conference-paper",
            "review",
            "book-chapter",
            "industry-guidance",
            "preprint",
            "secondary-synthesis"
          ]
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "authors": {
          "default": [],
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "year": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": -9007199254740991,
              "maximum": 9007199254740991
            },
            {
              "type": "null"
            }
          ]
        },
        "publishedDate": {
          "default": null,
          "anyOf": [
            {
              "type": "string",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "venue": {
          "default": null,
          "type": [
            "string",
            "null"
          ]
        },
        "doi": {
          "default": null,
          "type": [
            "string",
            "null"
          ]
        },
        "url": {
          "type": "string",
          "format": "uri"
        },
        "access": {
          "type": "string",
          "enum": [
            "full-text",
            "abstract-only",
            "none",
            "unknown"
          ]
        },
        "review": {
          "type": "object",
          "properties": {
            "status": {
              "type": "string",
              "enum": [
                "unverified-secondary",
                "verified-abstract",
                "verified-full-text",
                "verified-normative",
                "retracted"
              ]
            },
            "checkedOn": {
              "anyOf": [
                {
                  "type": "string",
                  "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
                },
                {
                  "type": "null"
                }
              ]
            },
            "checkedBy": {
              "default": null,
              "type": [
                "string",
                "null"
              ]
            },
            "locator": {
              "default": null,
              "description": "Where in the source the checked content lives (section, table, page).",
              "type": [
                "string",
                "null"
              ]
            },
            "notes": {
              "default": null,
              "type": [
                "string",
                "null"
              ]
            }
          },
          "required": [
            "status",
            "checkedOn"
          ]
        },
        "rights": {
          "type": "object",
          "properties": {
            "redistribution": {
              "type": "string",
              "enum": [
                "link-only",
                "open-license",
                "public-domain",
                "w3c-document-license"
              ]
            },
            "license": {
              "default": null,
              "type": [
                "string",
                "null"
              ]
            }
          },
          "required": [
            "redistribution"
          ]
        }
      },
      "required": [
        "id",
        "type",
        "title",
        "year",
        "url",
        "access",
        "review",
        "rights"
      ],
      "title": "Readability Lab source record"
    },
    "Claim": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^C-[A-Z0-9]+-\\d{3}$"
        },
        "revision": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "kind": {
          "type": "string",
          "enum": [
            "normative",
            "empirical",
            "heuristic",
            "hypothesis"
          ]
        },
        "title": {
          "type": "string"
        },
        "statement": {
          "type": "string",
          "description": "Original summary written for this registry."
        },
        "plain": {
          "type": "string",
          "description": "Plain-language version for everyday readers; no jargon."
        },
        "topics": {
          "minItems": 1,
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "outcomes": {
          "default": [],
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "legibility",
              "reading-speed",
              "comprehension",
              "recognition-accuracy",
              "comfort",
              "preference",
              "eye-movements",
              "accessibility-conformance",
              "layout-geometry",
              "usability"
            ]
          }
        },
        "scope": {
          "type": "object",
          "properties": {
            "scripts": {
              "default": [
                "Latin"
              ],
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "contexts": {
              "default": [],
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "notApplicableTo": {
              "default": [],
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        },
        "sources": {
          "minItems": 1,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "sourceId": {
                "type": "string",
                "pattern": "^S-[a-z0-9-]+$"
              },
              "locator": {
                "default": null,
                "type": [
                  "string",
                  "null"
                ]
              }
            },
            "required": [
              "sourceId"
            ]
          }
        },
        "study": {
          "default": null,
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "population": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "sampleSize": {
                  "description": "As reported, e.g. '20', '352 of 500 retained'",
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "language": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "script": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "task": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "device": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "typography": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "outcomes": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "enum": [
                      "legibility",
                      "reading-speed",
                      "comprehension",
                      "recognition-accuracy",
                      "comfort",
                      "preference",
                      "eye-movements",
                      "accessibility-conformance",
                      "layout-geometry",
                      "usability"
                    ]
                  }
                },
                "comparator": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "estimates": {
                  "default": [],
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "measure": {
                        "type": "string",
                        "description": "What was estimated, e.g. 'mean WPM at 95 CPL'"
                      },
                      "value": {
                        "type": [
                          "number",
                          "null"
                        ]
                      },
                      "unit": {
                        "default": null,
                        "type": [
                          "string",
                          "null"
                        ]
                      },
                      "ci95": {
                        "default": null,
                        "anyOf": [
                          {
                            "type": "array",
                            "prefixItems": [
                              {
                                "type": "number"
                              },
                              {
                                "type": "number"
                              }
                            ],
                            "items": false,
                            "minItems": 2,
                            "maxItems": 2
                          },
                          {
                            "type": "null"
                          }
                        ]
                      },
                      "p": {
                        "default": null,
                        "description": "As reported, e.g. '.02' or '<.001'",
                        "type": [
                          "string",
                          "null"
                        ]
                      },
                      "effectSize": {
                        "default": null,
                        "type": [
                          "string",
                          "null"
                        ]
                      },
                      "missingReason": {
                        "default": null,
                        "description": "Required when value is null: why the statistic is missing.",
                        "type": [
                          "string",
                          "null"
                        ]
                      }
                    },
                    "required": [
                      "measure",
                      "value"
                    ]
                  }
                },
                "missing": {
                  "default": [],
                  "description": "Fields not reported, with reasons.",
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              },
              "required": [
                "population",
                "sampleSize",
                "language",
                "script",
                "task",
                "device",
                "typography",
                "outcomes",
                "comparator"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "wcag": {
          "default": null,
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "criterion": {
                  "type": "string"
                },
                "level": {
                  "type": "string",
                  "enum": [
                    "A",
                    "AA",
                    "AAA",
                    "advisory"
                  ]
                }
              },
              "required": [
                "criterion",
                "level"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "evidenceStrength": {
          "type": "string",
          "enum": [
            "normative",
            "moderate",
            "low",
            "very-low",
            "not-established",
            "not-applicable"
          ],
          "description": "Strength of evidence for the claim as stated. Separate from recommendation priority."
        },
        "noReliableQuantitativeImprovement": {
          "default": false,
          "description": "True when the registry explicitly records that no reliable quantitative improvement is established.",
          "type": "boolean"
        },
        "limitations": {
          "default": [],
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "conflictsWith": {
          "default": [],
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^C-[A-Z0-9]+-\\d{3}$"
          }
        },
        "relatedClaims": {
          "default": [],
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^C-[A-Z0-9]+-\\d{3}$"
          }
        },
        "status": {
          "type": "string",
          "enum": [
            "draft",
            "extracted",
            "reviewed",
            "superseded",
            "withdrawn"
          ]
        },
        "history": {
          "minItems": 1,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "revision": {
                "type": "integer",
                "exclusiveMinimum": 0,
                "maximum": 9007199254740991
              },
              "date": {
                "type": "string",
                "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
              },
              "change": {
                "type": "string"
              },
              "reason": {
                "type": "string"
              },
              "by": {
                "default": null,
                "type": [
                  "string",
                  "null"
                ]
              }
            },
            "required": [
              "revision",
              "date",
              "change",
              "reason"
            ]
          }
        }
      },
      "required": [
        "id",
        "revision",
        "kind",
        "title",
        "statement",
        "plain",
        "topics",
        "scope",
        "sources",
        "evidenceStrength",
        "status",
        "history"
      ],
      "title": "Readability Lab claim"
    }
  },
  "$id": "urn:readability-lab:schema:evidence-registry"
}
