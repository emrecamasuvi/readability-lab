{
  "name": "@camasuvi/readability-lab-mcp",
  "version": "0.1.0",
  "description": "MCP server exposing Readability Lab inspection, comparison, recipes and the evidence registry to coding agents.",
  "license": "Apache-2.0",
  "type": "module",
  "bin": {
    "readability-lab-mcp": "./bin/readability-lab-mcp.mjs"
  },
  "files": [
    "dist",
    "bin"
  ],
  "scripts": {
    "build": "node build.mjs && node ../../scripts/licenses.mjs dist zod",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "playwright": "1.65.0",
    "zod": "^4.6.7"
  },
  "optionalDependencies": {
    "axe-core": "^4.14.0"
  },
  "devDependencies": {
    "@camasuvi/readability-lab-cli": "workspace:*",
    "@camasuvi/readability-lab-core": "workspace:*",
    "@camasuvi/readability-lab-inspector": "workspace:*"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/emrecamasuvi/readability-lab.git",
    "directory": "packages/mcp"
  },
  "homepage": "https://github.com/emrecamasuvi/readability-lab#readme",
  "bugs": "https://github.com/emrecamasuvi/readability-lab/issues",
  "publishConfig": {
    "access": "public"
  },
  "author": "Readability Lab contributors"
}
