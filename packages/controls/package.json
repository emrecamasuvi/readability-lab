{
  "name": "@camasuvi/readability-lab-controls",
  "version": "0.1.0",
  "description": "Embeddable reading-settings web component and headless API using the portable Readability Lab profile format.",
  "license": "Apache-2.0",
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      },
      "./element": "./dist/reading-controls.js"
    },
    "access": "public"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "node build.mjs && node ../../scripts/emit-types.mjs && node ../../scripts/licenses.mjs dist zod",
    "typecheck": "tsc -p tsconfig.json"
  },
  "devDependencies": {
    "@camasuvi/readability-lab-core": "workspace:*",
    "@camasuvi/readability-lab-inspector": "workspace:*"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/emrecamasuvi/readability-lab.git",
    "directory": "packages/controls"
  },
  "homepage": "https://github.com/emrecamasuvi/readability-lab#readme",
  "bugs": "https://github.com/emrecamasuvi/readability-lab/issues",
  "author": "Readability Lab contributors"
}
